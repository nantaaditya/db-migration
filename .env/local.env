SERVER_PORT=1000
DB_URL=jdbc:postgresql://host.docker.internal:5432/local_db
DB_USER=user
DB_PASS=password
JAVA_OPTS=-server -Xms128m -Xmx512m -XX:+IgnoreUnrecognizedVMOptions -XX:+UseContainerSupport -XX:+IdleTuningCompactOnIdle -XX:+IdleTuningGcOnIdle -Xtune:virtualized -XX:+UseG1GC -XX:MaxHeapFreeRatio=40 -XX:MinHeapFreeRatio=10 -XX:+UseCompressedOops -XX:+UseCompressedClassPointers -XX:+CompactStrings -XX:MinRAMPercentage=20.0 -XX:MaxRAMPercentage=75.0 -XX:+HeapDumpOnOutOfMemoryError